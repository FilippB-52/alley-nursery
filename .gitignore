# Every pattern for a root-level folder is anchored with a leading slash. Without it git
# matches the name at any depth — and since macOS sets core.ignorecase, "Fonts/" silently
# swallowed assets/fonts/ and "Greenaura/" swallowed assets/partners/greenaura/, which
# shipped a deploy with no webfonts. Keep the slashes.

# macOS
.DS_Store

